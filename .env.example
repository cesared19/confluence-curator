# Confluence Cloud
CONFLUENCE_BASE_URL=https://tu-empresa.atlassian.net
CONFLUENCE_EMAIL=tu.correo@empresa.com
# Créalo en https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=
# Clave del espacio (aparece en la URL: /wiki/spaces/CLAVE/...)
CONFLUENCE_SPACE_KEY=

# Jira Cloud: por defecto usa la URL, el correo y el token de Confluence.
# JIRA_BASE_URL=https://tu-empresa.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_MAX_IMAGES=5

# PDFs: máximo de páginas sin texto (escaneadas) que se envían como imágenes por parte
# PDF_MAX_SCANNED_PAGES=5

# Asesor: "anthropic" (Claude), "ollama" (modelo local) o "mock" (sin IA).
# Si se deja vacío, usa Claude solo si hay API key.
CURATOR_ADVISOR=

# Modelo local con Ollama (CURATOR_ADVISOR=ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_CONTEXT=32768

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high

# Usuario y contraseña para entrar a la interfaz (recomendado si no corre solo en tu equipo)
CURATOR_USER=
CURATOR_PASSWORD=

# CURATOR_DATABASE=data/curator.db
# CURATOR_DEMO=1   # Confluence simulado en memoria, para probar sin credenciales
