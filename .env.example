# Confluence Cloud
CONFLUENCE_BASE_URL=https://tu-empresa.atlassian.net
CONFLUENCE_EMAIL=tu.correo@empresa.com
# Créalo en https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=
# Clave del espacio (aparece en la URL: /wiki/spaces/CLAVE/...)
CONFLUENCE_SPACE_KEY=

# Asesor: "anthropic" (Claude) o "mock" (sin IA). Si se deja vacío, usa Claude solo si hay API key.
CURATOR_ADVISOR=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high

# Usuario y contraseña para entrar a la interfaz (recomendado si no corre solo en tu equipo)
CURATOR_USER=
CURATOR_PASSWORD=

# CURATOR_DATABASE=data/curator.db
# CURATOR_DEMO=1   # Confluence simulado en memoria, para probar sin credenciales
